# Copy this file to keystore.properties (same directory) and fill in your own values.
# keystore.properties is git-ignored and must NEVER be committed or shared -- whoever holds
# your keystore and its passwords can sign updates Android will treat as coming from the same
# app as everything you've already installed.
#
# Generate a release keystore first (do this once, then back the .jks file up somewhere safe --
# if you lose it, you can never publish an update under this app's identity again):
#
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore niix-release.jks \
#     -alias niix \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# It will ask for a keystore password, your name/org details (can be anything), and a key
# password (can be the same as the keystore password). Then fill in the four values below.

storeFile=niix-release.jks
storePassword=CHANGE_ME
keyAlias=niix
keyPassword=CHANGE_ME
