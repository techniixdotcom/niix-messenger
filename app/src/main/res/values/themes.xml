        <item name="niixOnPrimary">#FFFFFF</item>
        <item name="niixAccentLight">#33333B</item>
        <item name="niixEdge">#40000000</item>
        <item name="niixEdgeStrong">#80000000</item>
        <item name="niixSelected">#14000000</item>
        <item name="niixDivider">#14000000</item>
        <item name="niixLine">#24000000</item>
        <item name="niixBubbleOut">#14000000</item>
