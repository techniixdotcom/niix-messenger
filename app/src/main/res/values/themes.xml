        <item name="niixKeyAlt">#1A1A22</item>
        <item name="niixSearchHighlight">#4D4169E1</item>
    </style>

    <!-- Dark: white on black, with no colour at all. -->
    <style name="Theme.Niix.Dark" parent="Theme.Niix">
        <item name="niixBg">#000000</item>
        <item name="niixSurface">#121218</item>
        <item name="niixSurfaceVariant">#0B0B10</item>
        <item name="niixSurfaceRaised">#1A1A22</item>
        <item name="niixOnSurface">#F2F2F5</item>
        <item name="niixOnSurfaceMuted">#A0A0AE</item>
        <item name="niixOnSurfaceFaint">#7A7A88</item>
        <item name="niixPrimary">#FFFFFF</item>
        <item name="niixOnPrimary">#000000</item>
