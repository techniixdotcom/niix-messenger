    </style>

    <!-- Light: black on white. The only day-mode theme, so system bars get dark icons, and the
         danger red is darkened to stay readable on white. -->
    <style name="Theme.Niix.Light" parent="Theme.Niix">
        <item name="niixBg">#FFFFFF</item>
        <item name="niixSurface">#F4F4F6</item>
        <item name="niixSurfaceVariant">#FAFAFB</item>
        <item name="niixSurfaceRaised">#E9E9EE</item>
        <item name="niixOnSurface">#0B0B10</item>
