<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CalcKey" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">66dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/niix_on_surface</item>
        <item name="backgroundTint">@color/niix_calc_key</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="CalcKeyAlt" parent="CalcKey">
        <item name="backgroundTint">@color/niix_calc_key_alt</item>
        <item name="android:textColor">@color/niix_on_surface_muted</item>
    </style>

    <style name="CalcKeyOp" parent="CalcKey">
        <item name="backgroundTint">@color/niix_surface_variant</item>
        <item name="android:textColor">@color/niix_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalcKeyEquals" parent="CalcKey">
        <item name="backgroundTint">@color/niix_primary</item>
        <item name="android:textColor">@color/niix_on_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/niix_on_surface_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">14dp</item>
        <item name="cardBackgroundColor">@color/niix_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="SettingsRowTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/niix_on_surface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsRowDesc">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/niix_on_surface_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <!-- The NiiX wordmark.

         sans-serif-black is a system font present on every Android device, so nothing is
         bundled and no font licence applies. That matters more than it sounds: most attractive
         display fonts are personal-use-only, and shipping one in a published app is a licence
         violation that is easy to commit by accident.

         The rest of the app is monospace by design, which suits a terminal aesthetic but makes a
         wordmark read as ordinary text. A heavy geometric face with wide letter spacing reads as
         a mark instead. Replace fontFamily here when a real logo exists; both screens use this
         style, so they cannot drift apart. -->
    <style name="NiixWordmark">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/niix_green</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="NiixWordmarkSub">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/niix_pink</item>
        <item name="android:letterSpacing">0.34</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
