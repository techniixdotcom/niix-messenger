<?xml version="1.0" encoding="utf-8"?>
<!-- A field with a faint line, taking the theme colour while it has focus, as the site's inputs do. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/niixBg" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="?attr/niixEdgeStrong" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/niixBg" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="?attr/niixLine" />
        </shape>
    </item>
</selector>
