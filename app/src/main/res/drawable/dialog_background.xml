<?xml version="1.0" encoding="utf-8"?>
<!-- Dialogs: glass with the pink edge. MaterialAlertDialogBuilder insets this from the screen
     edges itself, so it is a plain shape. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/niix_surface" />
    <stroke android:width="1dp" android:color="@color/niix_edge" />
    <corners android:radius="16dp" />
</shape>
