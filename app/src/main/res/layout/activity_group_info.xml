<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@color/niix_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/niix_bg"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="@string/group_info_title"
        app:titleTextColor="@color/niix_on_surface" />

    <LinearLayout
        android:id="@+id/group_photo_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/group_avatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/avatar_square"
            android:gravity="center"
            android:textColor="@color/niix_pink"
            android:textStyle="bold"
            android:textSize="20sp"
            android:text="?"
            android:contentDescription="@string/group_photo" />

        <TextView
            android:id="@+id/group_title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:textColor="@color/niix_on_surface"
            android:textStyle="bold"
            android:textSize="17sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/niix_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/group_members"
            android:textColor="@color/niix_pink"
            android:textStyle="bold"
            android:textSize="13sp"
            android:letterSpacing="0.06" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"
            android:layout_marginHorizontal="10dp" android:background="@color/niix_divider" />
        <ImageButton
            android:id="@+id/btn_add_member"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="4dp"
            android:background="@drawable/avatar_square"
            android:src="@android:drawable/ic_input_add"
            app:tint="@color/niix_green"
            android:visibility="gone"
            android:contentDescription="@string/group_add_members" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/member_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingTop="4dp" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/niix_divider" />

    <LinearLayout
        android:id="@+id/row_leave_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:padding="16dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView style="@style/SettingsRowTitle" android:text="@string/group_leave" android:textColor="@color/niix_danger" />
            <TextView style="@style/SettingsRowDesc" android:text="@string/group_leave_desc" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
