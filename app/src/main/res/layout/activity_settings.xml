<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="?attr/niixBg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/niixBg"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="@string/action_settings"
        app:titleTextColor="?attr/niixOnSurface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <!-- Category list. Each section is reached from here and stays hidden until it's
                 chosen. -->
            <LinearLayout android:id="@+id/settings_menu" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                    <LinearLayout android:id="@+id/cat_profile" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/settings_cat_profile" />
                            <TextView style="@style/SettingsRowDesc" android:text="@string/settings_cat_profile_desc" />
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right" android:contentDescription="@string/settings_cat_profile" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="?attr/niixDivider" />

                    <LinearLayout android:id="@+id/cat_theme" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/settings_cat_theme" />
                            <TextView style="@style/SettingsRowDesc" android:text="@string/settings_cat_theme_desc" />
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right" android:contentDescription="@string/settings_cat_theme" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="?attr/niixDivider" />

                    <LinearLayout android:id="@+id/cat_privacy" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/settings_cat_privacy" />
                            <TextView style="@style/SettingsRowDesc" android:text="@string/settings_cat_privacy_desc" />
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right" android:contentDescription="@string/settings_cat_privacy" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="?attr/niixDivider" />

                    <LinearLayout android:id="@+id/cat_security" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/settings_cat_security" />
                            <TextView style="@style/SettingsRowDesc" android:text="@string/settings_cat_security_desc" />
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right" android:contentDescription="@string/settings_cat_security" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="?attr/niixDivider" />

                    <LinearLayout android:id="@+id/cat_backup" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/settings_cat_backup" />
                            <TextView style="@style/SettingsRowDesc" android:text="@string/settings_cat_backup_desc" />
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right" android:contentDescription="@string/settings_cat_backup" />
                    </LinearLayout>

                    <View android:id="@+id/cat_updates_divider" android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="?attr/niixDivider" />

                    <LinearLayout android:id="@+id/cat_updates" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/settings_cat_updates" />
                            <TextView style="@style/SettingsRowDesc" android:text="@string/settings_cat_updates_desc" />
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right" android:contentDescription="@string/settings_cat_updates" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="?attr/niixDivider" />

                    <LinearLayout android:id="@+id/cat_about" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/settings_cat_about" />
                            <TextView style="@style/SettingsRowDesc" android:text="@string/settings_cat_about_desc" />
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right" android:contentDescription="@string/settings_cat_about" />
                    </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout android:id="@+id/section_theme" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView style="@style/SettingsSection" android:text="@string/settings_cat_theme" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <!-- One row per theme, made in SettingsActivity from NiixTheme. -->
                <LinearLayout android:id="@+id/theme_options" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/SettingsRowDesc"
                android:layout_width="match_parent"
                android:layout_marginHorizontal="20dp" android:layout_marginTop="10dp"
                android:text="@string/theme_note" />
            </LinearLayout>

            <LinearLayout android:id="@+id/section_privacy" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView style="@style/SettingsSection" android:text="@string/settings_section_privacy" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/setting_blur_messages" />
                            <TextView style="@style/SettingsRowDesc" android:text="@string/setting_blur_messages_desc" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_blur_messages" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="12dp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="?attr/niixDivider" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/setting_allowlist_only" />
                            <TextView style="@style/SettingsRowDesc" android:text="@string/setting_allowlist_desc" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_allowlist" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="12dp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="?attr/niixDivider" />

                    <LinearLayout android:id="@+id/row_blocked" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/setting_blocked" />
                            <TextView style="@style/SettingsRowDesc" android:text="@string/setting_blocked_desc" />
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right" android:contentDescription="@string/setting_blocked" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="?attr/niixDivider" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/setting_notification_privacy" />
                            <TextView style="@style/SettingsRowDesc" android:text="@string/setting_notif_desc" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_notif_privacy" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="12dp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="?attr/niixDivider" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/setting_screenshots" />
                            <TextView style="@style/SettingsRowDesc" android:text="@string/setting_screenshots_desc" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_screenshots" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="12dp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="?attr/niixDivider" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/setting_phone_keyboard" />
                            <TextView style="@style/SettingsRowDesc" android:text="@string/setting_phone_keyboard_desc" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_phone_keyboard" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="12dp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="?attr/niixDivider" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/setting_nostr" />
                            <TextView style="@style/SettingsRowDesc" android:text="@string/setting_nostr_desc" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_nostr" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="12dp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="?attr/niixDivider" />

                    <LinearLayout android:id="@+id/row_nostr_relays" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/setting_nostr_relays" />
                            <TextView style="@style/SettingsRowDesc" android:text="@string/setting_nostr_relays_desc" />
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right" android:contentDescription="@string/setting_nostr_relays" />
                    </LinearLayout>


                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="?attr/niixDivider" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/setting_announce_online" />
                            <TextView style="@style/SettingsRowDesc" android:text="@string/setting_announce_online_desc" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_announce_online" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="12dp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="?attr/niixDivider" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/setting_cover_traffic" />
                            <TextView style="@style/SettingsRowDesc" android:text="@string/setting_cover_traffic_desc" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_cover_traffic" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="12dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout android:id="@+id/section_security" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView style="@style/SettingsSection" android:text="@string/settings_section_security" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/setting_require_passcode" />
                            <TextView style="@style/SettingsRowDesc" android:text="@string/setting_require_passcode_desc" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_require_passcode" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="12dp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="?attr/niixDivider" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/setting_disconnect_locked" />
                            <TextView style="@style/SettingsRowDesc" android:text="@string/setting_disconnect_locked_desc" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_disconnect_locked" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="12dp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="?attr/niixDivider" />

                    <LinearLayout android:id="@+id/row_duress" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/setting_set_duress" />
                            <TextView style="@style/SettingsRowDesc" android:text="@string/setting_duress_desc" />
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right" android:contentDescription="@string/setting_set_duress" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="?attr/niixDivider" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/setting_wipe_no_confirm" />
                            <TextView style="@style/SettingsRowDesc" android:text="@string/setting_wipe_no_confirm_desc" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_wipe_no_confirm" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="12dp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="?attr/niixDivider" />

                    <LinearLayout android:id="@+id/row_inactivity_wipe" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/setting_inactivity_wipe" />
                            <TextView android:id="@+id/text_inactivity_wipe" style="@style/SettingsRowDesc" />
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right" android:contentDescription="@string/setting_inactivity_wipe" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="?attr/niixDivider" />

                    <LinearLayout android:id="@+id/row_devices" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/setting_devices" />
                            <TextView style="@style/SettingsRowDesc" android:text="@string/setting_devices_desc" />
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right" android:contentDescription="@string/setting_devices" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="?attr/niixDivider" />

                    <LinearLayout android:id="@+id/row_remote_wipe" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/setting_remote_wipe" />
                            <TextView android:id="@+id/remote_wipe_status" style="@style/SettingsRowDesc" android:text="@string/setting_remote_wipe_desc" />
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right" android:contentDescription="@string/setting_remote_wipe" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="16dp" android:background="?attr/niixDivider" />

                    <LinearLayout android:id="@+id/row_wipe_now" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/setting_wipe_now" android:textColor="?attr/niixDanger" />
                            <TextView style="@style/SettingsRowDesc" android:text="@string/setting_wipe_now_desc" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout android:id="@+id/section_backup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView style="@style/SettingsSection" android:text="@string/settings_section_backup" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                    <LinearLayout android:id="@+id/row_export" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/setting_export" />
