<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@color/niix_bg"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        style="@style/NiixWordmark"
        android:text="@string/app_name"
        android:textSize="34sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/NiixWordmarkSub"
        android:text="@string/brand_subtitle"
        android:textSize="10sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:text="@string/passcode_prompt"
        android:textColor="@color/niix_on_surface_muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/passcode_display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/passcode_placeholder"
        android:textColor="@color/niix_on_surface"
        android:textSize="28sp"
        android:letterSpacing="0.2"
        android:gravity="center" />

    <TextView
        android:id="@+id/passcode_console"
        style="@style/NiixConsole"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="12dp" />

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <GridLayout
        android:id="@+id/passcode_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp"
        android:columnCount="3"
        android:rowCount="4">

        <Button android:text="1" style="@style/PinKey" />
        <Button android:text="2" style="@style/PinKey" />
        <Button android:text="3" style="@style/PinKey" />
        <Button android:text="4" style="@style/PinKey" />
        <Button android:text="5" style="@style/PinKey" />
        <Button android:text="6" style="@style/PinKey" />
        <Button android:text="7" style="@style/PinKey" />
        <Button android:text="8" style="@style/PinKey" />
        <Button android:text="9" style="@style/PinKey" />
        <Button android:text="⌫" style="@style/PinKeyAlt" />
        <Button android:text="0" style="@style/PinKey" />
        <Button android:id="@+id/passcode_unlock" android:text="✓" style="@style/PinKeyGo" />
    </GridLayout>
</LinearLayout>
