<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="end"
    android:paddingHorizontal="10dp"
    android:paddingVertical="3dp">

    <TextView
        android:id="@+id/body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="280dp"
        android:background="@drawable/bubble_out"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="@color/niix_message_out_text"
        android:textSize="15sp" />


    <ImageView
        android:id="@+id/attachment_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="240dp"
        android:maxHeight="320dp"
        android:adjustViewBounds="true"
        android:visibility="gone"
        android:contentDescription="@string/attachment_label" />

    <TextView
        android:id="@+id/attachment_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="280dp"
        android:background="@drawable/bubble_out"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="@color/niix_message_out_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="4dp"
        android:textColor="@color/niix_on_surface_muted"
        android:textSize="11sp" />
</LinearLayout>
