<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="?attr/niixBg"
    android:paddingHorizontal="24dp"
    android:paddingVertical="32dp">

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/call_avatar"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/avatar_square"
        android:gravity="center"
        android:textColor="?attr/niixPrimary"
        android:textSize="48sp"
        android:textStyle="bold"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/call_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="?attr/niixOnSurface"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/call_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:accessibilityLiveRegion="polite"
        android:textColor="?attr/niixOnSurfaceMuted"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/call_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/jetbrains_mono"
        android:gravity="center"
        android:textColor="?attr/niixPrimary"
        android:textIsSelectable="false"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/call_code_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/call_safety_hint"
        android:textColor="?attr/niixOnSurfaceMuted"
        android:textSize="13sp"
        android:visibility="gone" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/call_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/call_mute"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/call_mute"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/call_speaker"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/call_speaker"
            app:cornerRadius="16dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/call_end"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="@string/call_hang_up"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="?attr/niixDanger"
            app:strokeColor="?attr/niixDanger"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/call_answer"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/call_answer"
            android:textColor="?attr/niixOnPrimary"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="?attr/niixPrimary"
            app:strokeColor="?attr/niixPrimary"
            app:cornerRadius="18dp" />
    </LinearLayout>
</LinearLayout>
