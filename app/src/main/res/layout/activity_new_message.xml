<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@color/niix_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/niix_bg"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="@string/new_message_title"
        app:titleTextColor="@color/niix_on_surface" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/niix_bg"
        app:tabIndicatorColor="@color/niix_green"
        app:tabSelectedTextColor="@color/niix_green"
        app:tabTextColor="@color/niix_on_surface_muted">
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_enter_code" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_scan_qr" />
    </com.google.android.material.tabs.TabLayout>

    <LinearLayout
        android:id="@+id/panel_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_contact_hint"
            android:textColor="@color/niix_on_surface_muted"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="14dp" />

        <FrameLayout
            android:id="@+id/contact_name_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:id="@+id/share_code_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="@string/action_add_contact"
            app:cornerRadius="14dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_scan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/scan_panel_hint"
            android:textColor="@color/niix_on_surface_muted"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scan_button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/action_scan_qr"
            app:icon="@android:drawable/ic_menu_camera"
            app:cornerRadius="14dp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/my_code_button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="16dp"
        android:text="@string/action_show_my_code"
        style="@style/Widget.Material3.Button.TonalButton"
        app:cornerRadius="14dp" />
</LinearLayout>
